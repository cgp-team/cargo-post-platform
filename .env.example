# Development placeholders only. Copy to .env and replace before use.
DB_NAME=cargo_post_dev
DB_USER=cargo_post_dev
DB_PASSWORD=dev-only-change-me-db
DB_PORT=3306

REDIS_PASSWORD=dev-only-change-me-redis
REDIS_PORT=6379

MINIO_ROOT_USER=cargo_post_dev
MINIO_ROOT_PASSWORD=dev-only-change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_PORT=48080
FRONTEND_PORT=80
ALGORITHM_PORT=18081
# 自研 algorithm 服务（OR-Tools，compose 映射宿主机 18081）
# 后端跑在宿主机，须用 127.0.0.1 宿主端口，docker 网络主机名（algorithm:8000）在宿主机不可解析
ALGORITHM_BASE_URL=http://127.0.0.1:18081

# 高德开放平台「Web服务」类型 key（algorithm 服务距离测量用）；
# 留空 = 欧氏直线距离（度），配置 = 驾车路网距离（公里），注入 algorithm 容器 env 生效
# 高德开放平台「Web服务」类型 key（algorithm 服务距离测量 + 后端现实公交层共用）
# 必须是「Web服务」类型；「微信小程序」类型 key 请配到 miniprogram/utils/config.js 的 AMAP_MINI_KEY
# 建议同时在高德控制台给该 key 配置「IP 白名单」= 服务器公网出口 IP（curl -s https://ipinfo.io/ip 查询）
AMAP_KEY=

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

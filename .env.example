# Development placeholders only. Copy to .env and replace before use.
DB_NAME=cargo_post_dev
DB_USER=cargo_post_dev
DB_PASSWORD=dev-only-change-me-db
DB_PORT=3306

REDIS_PASSWORD=dev-only-change-me-redis
REDIS_PORT=6379

BACKEND_PORT=48080
FRONTEND_PORT=80
ALGORITHM_PORT=18081
# 自研 algorithm 服务（OR-Tools，compose 映射宿主机 18081）
# 后端跑在宿主机，须用 127.0.0.1 宿主端口，docker 网络主机名（algorithm:8000）在宿主机不可解析
ALGORITHM_BASE_URL=http://127.0.0.1:18081

# 高德开放平台「Web服务」类型 key（algorithm 服务距离测量用）；
# 留空 = 欧氏直线距离（度），配置 = 驾车路网距离（公里），注入 algorithm 容器 env 生效
# 高德开放平台「Web服务」类型 key（algorithm 服务距离测量 + 后端现实公交层共用）
# 必须是「Web服务」类型；「微信小程序」类型 key 请配到小程序仓库（cargo-post-miniprogram）utils/config.js 的 AMAP_MINI_KEY
# 建议同时在高德控制台给该 key 配置「IP 白名单」= 服务器公网出口 IP（curl -s https://ipinfo.io/ip 查询）
AMAP_KEY=

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ===== 后端密钥类环境变量（application.yaml/application-dev.yaml 已改为 ${VAR:演示默认值} 注入） =====
# 说明：仓库里的默认值都是 yudao 上游的公开演示凭据，开发环境可直接用；
# 生产部署必须换成真实凭据，并写入 /opt/cargo-post/app.env（systemd EnvironmentFile）后重启后端。
# 以下变量留空 = 继续用仓库默认值，按需取消注释：
# MP_ENCRYPTOR_PASSWORD=            # mybatis-plus 字段加解密密钥（16 位）
# API_ENCRYPT_REQUEST_KEY=          # api-encrypt 请求加密 AES key（16/24/32 位）
# API_ENCRYPT_RESPONSE_KEY=         # api-encrypt 响应加密 AES key（16/24/32 位）
# WX_MP_APP_ID=                     # 微信公众号 appid
# WX_MP_SECRET=                     # 微信公众号 secret
# WX_MINIAPP_APPID=                 # 微信小程序 appid
# WX_MINIAPP_SECRET=                # 微信小程序 secret（上线前必换+在微信后台重置历史泄露的 secret）
# TENCENT_LBS_KEY=                  # 腾讯位置服务 key
# JUSTAUTH_DINGTALK_CLIENT_ID/SECRET=      # 钉钉登录（未用可不管）
# JUSTAUTH_WECOM_CLIENT_ID/SECRET=         # 企业微信登录（未用可不管）
